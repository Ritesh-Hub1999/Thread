Producer and consumer:

#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <queue>

std::queue<int> dataQueue;  
std::mutex mtx;  
std::condition_variable cv;  
bool finished = false;  

void producer() {
    for (int i = 1; i <= 5; ++i) {
        std::this_thread::sleep_for(std::chrono::milliseconds(500)); // Simulate work
        std::lock_guard<std::mutex> lock(mtx); // Lock before modifying shared resource
        dataQueue.push(i);
        std::cout << "Produced: " << i << "\n";
        cv.notify_one(); // Notify consumer
    }
    finished = true;
    cv.notify_all(); // Wake up all consumers
}

void consumer() {
    while (true) {
        std::unique_lock<std::mutex> lock(mtx); // Lock before checking condition
        cv.wait(lock, [] { return !dataQueue.empty() || finished; }); // Wait for data

        while (!dataQueue.empty()) {
            std::cout << "Consumed: " << dataQueue.front() << "\n";
            dataQueue.pop();
        }
        
        if (finished) break; // Exit if production is done
    }
}

int main() {
    std::thread t1(producer);
    std::thread t2(consumer);

    t1.join();
    t2.join();
    return 0;
}

Print Odd-Even Numbers Using Two Threads:

#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>

std::mutex mtx;
std::condition_variable cv;
bool oddTurn = true; // Controls turn

void printOdd(int n) {
    for (int i = 1; i <= n; i += 2) {
        std::unique_lock<std::mutex> lock(mtx);
        cv.wait(lock, [] { return oddTurn; });
        std::cout << i << " ";
        oddTurn = false;
        cv.notify_one();
    }
}

void printEven(int n) {
    for (int i = 2; i <= n; i += 2) {
        std::unique_lock<std::mutex> lock(mtx);
        cv.wait(lock, [] { return !oddTurn; });
        std::cout << i << " ";
        oddTurn = true;
        cv.notify_one();
    }
}

int main() {
    int n = 10; // Print 1 to 10
    std::thread t1(printOdd, n);
    std::thread t2(printEven, n);
    t1.join();
    t2.join();
    return 0;
}

Print FooBar Alternately Using Two Threads:

#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>

std::mutex mtx;
std::condition_variable cv;
bool printFoo = true;

void printFoo(int n) {
    for (int i = 0; i < n; ++i) {
        std::unique_lock<std::mutex> lock(mtx);
        cv.wait(lock, [] { return printFoo; });
        std::cout << "Foo ";
        printFoo = false;
        cv.notify_one();
    }
}

void printBar(int n) {
    for (int i = 0; i < n; ++i) {
        std::unique_lock<std::mutex> lock(mtx);
        cv.wait(lock, [] { return !printFoo; });
        std::cout << "Bar ";
        printFoo = true;
        cv.notify_one();
    }
}

int main() {
    int n = 5; // Print "Foo Bar" 5 times
    std::thread t1(printFoo, n);
    std::thread t2(printBar, n);
    t1.join();
    t2.join();
    return 0;
}